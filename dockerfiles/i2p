FROM ubuntu:noble

ARG TARGETARCH

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y wget sudo

RUN set -ex; \
    wget "https://github.com/PurpleI2P/i2pd/releases/download/2.59.0/i2pd_2.59.0-1trixie1_${TARGETARCH}.deb" -O i2pd.deb -q && \
    apt-get install -y ./i2pd.deb && \
    rm i2pd.deb && \
    rm -rf /var/lib/apt/lists/*

COPY --chown=i2pd:i2pd dockerfiles/i2p-config /i2p-config

USER i2pd
EXPOSE 4447
ENTRYPOINT ["i2pd", "--conf", "/i2p-config/i2pd.conf", "--datadir", "/var/lib/i2pd"]
