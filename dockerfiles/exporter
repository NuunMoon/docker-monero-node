FROM golang:trixie AS og

# Install exporter from Github
RUN CGO_ENABLED=0 go install github.com/cirocosta/monero-exporter/cmd/monero-exporter@master

# Copy installed binary to a scratch image
FROM scratch
COPY --from=og /go/bin/monero-exporter /usr/local/bin/monero-exporter

ENTRYPOINT [ "monero-exporter" ]
